rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true))
      );
    }

    // Strict rules for the "users" collection
    match /users/{userId} {
      // Anyone logged in can read profile data
      allow read: if isAuthenticated();
      
      // Prevent privilege escalation: Users cannot assign themselves role: "admin" or isAdmin: true
      allow create: if isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role != 'admin')
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin != true);

      // Users can update their profile, but cannot tamper with 'role' or 'isAdmin' fields unless they are already an Admin
      allow update: if isOwner(userId) && (
        isAdmin() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin'])
      );

      // Only owner can delete their own account
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Strict rules for the "system_settings" collection
    match /system_settings/{settingId} {
      // Anyone can read system settings (e.g. comment cooldown, global configurations)
      allow read: if true;

      // Only verified Admin users can modify system settings
      allow write: if isAdmin();
    }

    // Strict rules for the "libraries" collection
    match /libraries/{libraryId} {
      // Users can only read their own library items (or Admin)
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can only delete a library item if it exists and belongs to them (or Admin)
      allow delete: if isOwner(resource.data.userId) || isAdmin();
      
      // Users can only create or update a library item if the data's userId matches their authenticated UID
      allow create, update: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Strict rules for the "comments" collection
    match /comments/{commentId} {
      // Anyone can view comments
      allow read: if true;

      // Users can delete their own comments, Admins can moderate/delete any comment
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // Update rules:
      // - Comment owner can edit their own comment's content, isEdited, and updatedAt fields
      // - Any logged-in user can update likesCount and dislikesCount fields (reactions)
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'isEdited', 'updatedAt']))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'dislikesCount'])
      );

      // Create rules:
      // - Must be logged in and writing their own userId
      // - Comment creation timestamp must match the request time
      // - Must update user profile lastCommentedAt to current request time in the same batch
      // - Initial reactions must start at 0
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('likesCount', 0) == 0
        && request.resource.data.get('dislikesCount', 0) == 0
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastCommentedAt == request.time;
    }

    // Strict rules for the "comment_reactions" collection
    match /comment_reactions/{reactionId} {
      // Users can only read their own reaction documents
      allow read: if isOwner(resource.data.userId);

      // Users can only create or update their own reactions
      allow create, update: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && (resource == null || resource.data.userId == request.auth.uid);

      // Users can delete their own reactions
      allow delete: if isOwner(resource.data.userId);
    }

    // Strict rules for the "notifications" collection
    match /notifications/{notificationId} {
      // User can only read their own notifications (or Admin)
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      
      // Logged-in users can only create 'reply' notifications to another user (system notifications are written via Admin SDK)
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.userId != request.auth.uid
        && request.resource.data.type == 'reply'
        && request.resource.data.createdAt == request.time;
      
      // User can update/delete their own notifications (e.g. mark as read or dismiss)
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Strict rules for the "watch_history" collection
    match /watch_history/{historyId} {
      // Users can only read their own watch history items (or Admin)
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can only delete a history item if it exists and belongs to them (or Admin)
      allow delete: if isOwner(resource.data.userId) || isAdmin();
      
      // Users can only create or update a history item if the data's userId matches their authenticated UID
      allow create, update: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
